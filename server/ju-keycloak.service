# Keycloak für JU Hamburg Finanzen (installiert von server/keycloak-einrichten.sh)
# Nur auf 127.0.0.1:8180 (Management/Health 127.0.0.1:9000); nach außen nur die Anmeldeseiten über Tailscale Serve.
[Unit]
Description=Keycloak (Anmeldung JU Hamburg Finanzen)
Documentation=file:/opt/ju-finanzen/current/SERVER.md
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=keycloak
Group=keycloak
# erster Admin: nur beim allerersten Start vorhanden (keycloak-einrichten löscht die Datei danach)
EnvironmentFile=-/run/ju-keycloak-bootstrap.env
Environment="JAVA_OPTS_KC_HEAP=-Xms256m -Xmx768m" "LANG=C.UTF-8" "TZ=Europe/Berlin"
ExecStart=/opt/keycloak/current/bin/kc.sh start --optimized
# Java beendet sich auf SIGTERM mit 143
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
UMask=0077
# /opt/keycloak/current/data zeigt hierher; sonst ist nichts beschreibbar
StateDirectory=keycloak
StateDirectoryMode=0700
MemoryMax=1536M
TasksMax=512

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Netz nur über 127.0.0.1/::1: Tailscale Serve und das Programm kommen von dort, PostgreSQL liegt auf 127.0.0.1
IPAddressAllow=localhost
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
