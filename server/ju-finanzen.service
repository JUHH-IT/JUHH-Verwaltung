# JU Hamburg Finanzen – Dienst im Serverbetrieb (installiert von server/install.sh)
# Läuft als eigener Benutzer ohne Anmeldung, nur auf 127.0.0.1 (Zugriff über Tailscale Serve), stark eingeschränkt.
[Unit]
Description=JU Hamburg Finanzen
Documentation=file:/opt/ju-finanzen/current/SERVER.md
After=network.target

[Service]
Type=simple
User=jufinanzen
Group=jufinanzen
EnvironmentFile=/etc/ju-finanzen/ju-finanzen.env
Environment="LANG=C.UTF-8" "TZ=Europe/Berlin" "PYTHONUNBUFFERED=1" "PYTHONDONTWRITEBYTECODE=1" "HOME=/var/lib/ju-finanzen"
WorkingDirectory=/var/lib/ju-finanzen
ExecStart=/opt/ju-finanzen/current/venv/bin/python /opt/ju-finanzen/current/app.py --no-browser
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
# Datenordner legt systemd sicher an (Besitzer jufinanzen, 0700)
StateDirectory=ju-finanzen ju-finanzen/Daten ju-finanzen/Sicherungen ju-finanzen/geheim
StateDirectoryMode=0700
# Obergrenzen gegen Überlastung (Speicher bei großen Importen/PDFs genügt reichlich)
MemoryMax=768M
TasksMax=96

# Härtung: nur der Datenordner ist beschreibbar, kein Zugriff auf /home, Geräte, Kernel
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/ju-finanzen
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
