#!/usr/bin/env bash
# Verwaltungsbefehl für JU Hamburg Finanzen im Serverbetrieb (installiert nach /usr/local/bin/ju-finanzen).
#   sudo ju-finanzen passwort "Name"        Passwort setzen/ändern (fragt zweimal, zeigt nichts an)
#   sudo ju-finanzen benutzer               Benutzer mit Rollen anzeigen
#   sudo ju-finanzen rolle "Name" Rolle     Notzugang: Rolle vergeben (--entfernen nimmt sie)
#   sudo ju-finanzen notfall-aus            Notfall- und Wartungsmodus beenden (Notzugang)
#   sudo ju-finanzen uebernehmen DATEI      Daten aus der Mac-App übernehmen (stoppt und startet den Dienst)
#   sudo ju-finanzen sicherung              Sicherung jetzt anlegen
#   sudo ju-finanzen pruefen                Datenbank prüfen (nur Anzahlen)
#   sudo ju-finanzen aktualisieren [Version] [--pruefen]   neue freigegebene Version aus dem Git-Repository installieren
#   sudo ju-finanzen status | protokoll | neustart
#   sudo ju-finanzen anmeldung keycloak|passwort   Anmeldung umstellen (startet den Dienst neu)
#   sudo ju-finanzen keycloak-verbinden "Name" [--kc-name name]   Person mit Keycloak verbinden (zeigt einmal ein Startpasswort)
#   sudo ju-finanzen notzugang [--minuten N | --aus]   Keycloak-Betrieb: Notzugang (Passwort) befristet freischalten (Standard 60)
#   sudo ju-finanzen keycloak-einrichten    Keycloak (Zwei-Faktor-Anmeldung) einrichten bzw. auffrischen – wiederholbar
#   sudo ju-finanzen keycloak-status        Keycloak: Dienst, Health, Version
#   sudo ju-finanzen keycloak-sicherung     Keycloak-Datenbank jetzt sichern (sonst täglich per Timer)
set -euo pipefail
SERVICE=ju-finanzen
SERVICE_USER=jufinanzen
ENV_FILE=/etc/ju-finanzen/ju-finanzen.env
APP=/opt/ju-finanzen/current
[ "$(id -u)" -eq 0 ] || { echo "Bitte mit sudo ausführen: sudo ju-finanzen $*" >&2; exit 1; }
[ -f "$ENV_FILE" ] && [ -x "$APP/venv/bin/python" ] || { echo "JU Hamburg Finanzen ist nicht installiert (server/install.sh)." >&2; exit 1; }

value() { sed -n "s/^$1=//p" "$ENV_FILE" | tail -n 1 | tr -d '\r'; }
for key in JU_FINANZEN_DATEN JU_FINANZEN_SICHERUNGEN; do   # Pfade müssen absolut sein (sonst arbeitet root im aktuellen Ordner)
  case "$(value "$key")" in /*) ;; *) echo "$key in $ENV_FILE fehlt oder ist kein absoluter Pfad." >&2; exit 1 ;; esac
done
run() {
  cd /
  runuser -u "$SERVICE_USER" -- env -i PATH=/usr/bin:/bin LANG=C.UTF-8 TZ=Europe/Berlin \
    JU_FINANZEN_DATEN="$(value JU_FINANZEN_DATEN)" JU_FINANZEN_SICHERUNGEN="$(value JU_FINANZEN_SICHERUNGEN)" \
    JU_FINANZEN_PORT="$(value JU_FINANZEN_PORT)" PYTHONDONTWRITEBYTECODE=1 \
    "$APP/venv/bin/python" "$APP/verwaltung.py" "$@"
}
running() { systemctl is-active --quiet "$SERVICE" 2>/dev/null; }
keycloak_kurz() {   # Version, Dienst, Health (Management-Schnittstelle nur auf 127.0.0.1)
  printf 'Version %s, Dienst %s, Health %s' "$(basename "$(readlink -f /opt/keycloak/current)")" \
    "$(systemctl is-active ju-keycloak 2>/dev/null || true)" \
    "$(curl -fsS -m 5 http://127.0.0.1:9000/auth/health/ready 2>/dev/null | grep -o '"status": *"[A-Z]*"' | grep -o '[A-Z]*' || echo 'nicht erreichbar')"
}

case "${1:-}" in
  ""|-h|--help|hilfe) sed -n '2,17p' "$0"; exit 0 ;;
  status)
    echo "Programmversion: $(sed -n "s/^VERSION='\(.*\)'.*/\1/p" "$APP/app.py" | head -n 1)$( [ -f "$APP/server/GIT-STAND" ] && printf ' (Stand %.12s)' "$(cat "$APP/server/GIT-STAND")" )"
    systemctl status "$SERVICE" --no-pager || true; command -v tailscale >/dev/null && tailscale serve status || true
    [ -e /opt/keycloak/current ] && echo "Keycloak: $(keycloak_kurz)" || true ;;
  keycloak-einrichten)
    shift
    [ -x "$APP/server/keycloak-einrichten.sh" ] || { echo "Diese Programmversion kennt Keycloak noch nicht." >&2; exit 1; }
    exec "$APP/server/keycloak-einrichten.sh" "$@" ;;
  keycloak-status)
    [ -e /opt/keycloak/current ] || { echo "Keycloak ist nicht eingerichtet (sudo ju-finanzen keycloak-einrichten)." >&2; exit 1; }
    systemctl status ju-keycloak --no-pager || true
    echo "Keycloak: $(keycloak_kurz)"
    systemctl list-timers ju-keycloak-sicherung.timer --no-pager || true ;;
  keycloak-sicherung)
    # nur root: die Sicherung enthält Passwort-Hashes und TOTP-Schlüssel – der Programmbenutzer liest sie nicht
    dir=/var/backups/ju-keycloak; file="$dir/keycloak-$(date +%F).dump"
    install -d -m 700 -o root -g root "$dir"
    (cd / && runuser -u postgres -- pg_dump -Fc keycloak) | (umask 077; cat > "$file.neu")
    mv -f "$file.neu" "$file"
    find "$dir" -name 'keycloak-*.dump' -mtime +30 -delete
    echo "Keycloak-Datenbank gesichert: $file" ;;
  aktualisieren)
    shift
    [ -x "$APP/server/aktualisieren.sh" ] || { echo "Diese Programmversion kennt das Update aus dem Git-Repository noch nicht (ab 0.33)." >&2; exit 1; }
    exec "$APP/server/aktualisieren.sh" "$@" ;;
  protokoll) journalctl -u "$SERVICE" -n "${2:-100}" --no-pager ;;
  neustart) systemctl restart "$SERVICE" && echo "Dienst neu gestartet." ;;
  anmeldung)
    art="${2:-}"
    case "$art" in keycloak|passwort) ;; *) echo "Aufruf: sudo ju-finanzen anmeldung keycloak|passwort (derzeit: $(value JU_FINANZEN_ANMELDUNG | sed 's/^$/passwort/'))" >&2; exit 1 ;; esac
    if [ "$art" = keycloak ]; then
      for key in ISSUER INTERN CLIENT SECRET RUECKKEHR; do
        [ -n "$(value "JU_FINANZEN_KEYCLOAK_$key")" ] || { echo "JU_FINANZEN_KEYCLOAK_$key fehlt – zuerst: sudo ju-finanzen keycloak-einrichten" >&2; exit 1; }
      done
    fi
    if grep -q '^JU_FINANZEN_ANMELDUNG=' "$ENV_FILE"; then sed -i "s/^JU_FINANZEN_ANMELDUNG=.*/JU_FINANZEN_ANMELDUNG=$art/" "$ENV_FILE"
    else printf 'JU_FINANZEN_ANMELDUNG=%s\n' "$art" >> "$ENV_FILE"; fi
    systemctl restart "$SERVICE"; sleep 3
    if running; then echo "Anmeldung: $art. Dienst läuft."
    else echo "Dienst startet nicht – zurück auf Passwort-Anmeldung. Protokoll: sudo ju-finanzen protokoll" >&2
      sed -i "s/^JU_FINANZEN_ANMELDUNG=.*/JU_FINANZEN_ANMELDUNG=passwort/" "$ENV_FILE"; systemctl restart "$SERVICE"; exit 1; fi ;;
  uebernehmen)
    shift
    [ $# -ge 1 ] && [ -f "$1" ] || { echo "Aufruf: sudo ju-finanzen uebernehmen /pfad/JU-Sicherung.zip [--ersetzen]" >&2; exit 1; }
    src="$1"; shift
    data_root="$(dirname "$(value JU_FINANZEN_DATEN)")"
    tmp="$(mktemp "$data_root/.uebernahme-XXXXXX")"
    trap 'rm -f "$tmp"' EXIT
    install -m 600 -o "$SERVICE_USER" -g "$SERVICE_USER" "$src" "$tmp"   # der Dienstbenutzer darf /home nicht lesen
    was_running=0
    if running; then was_running=1; echo "Dienst wird für die Übernahme angehalten …"; systemctl stop "$SERVICE"; fi
    status=0
    run uebernehmen "$tmp" "$@" || status=$?
    if [ "$was_running" -eq 1 ] || [ "$status" -eq 0 ]; then systemctl start "$SERVICE" && echo "Dienst gestartet."; fi
    exit "$status" ;;
  *) run "$@" ;;
esac
