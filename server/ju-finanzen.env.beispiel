# JU Hamburg Finanzen – Einstellungen des Dienstes.
# Nach einer Änderung: sudo systemctl restart ju-finanzen
# Seit 0.42 gibt es nur den Serverbetrieb; die Zeile bleibt, weil ältere Versionen (install.sh --zurueck) sie brauchen.
JU_FINANZEN_MODUS=server

# Adresse, an die der Server bindet. 127.0.0.1 = nur auf diesem Rechner; erreichbar über Tailscale Serve.
# Alternative ohne Tailscale Serve: die Tailscale-Adresse des Servers (100.x.y.z) – nie 0.0.0.0.
JU_FINANZEN_HOST=127.0.0.1
JU_FINANZEN_PORT=8769

# Adresse(n), unter denen die Oberfläche im Browser aufgerufen wird (mehrere mit Komma), z. B.
# https://ju-finanzen.beispiel.ts.net (Tailscale Serve) oder http://100.64.0.7:8769 (direkt über die Tailscale-Adresse).
JU_FINANZEN_ADRESSEN=

# Datenordner und Sicherungen müssen unter /var/lib/ju-finanzen liegen (nur dort darf der Dienst schreiben).
JU_FINANZEN_DATEN=/var/lib/ju-finanzen/Daten
JU_FINANZEN_SICHERUNGEN=/var/lib/ju-finanzen/Sicherungen
# Passwort des E-Mail-Kontos (nur wenn „auf dem Server speichern“ gewählt), nie in Daten oder Sicherungen
JU_FINANZEN_GEHEIMNISSE=/var/lib/ju-finanzen/geheim

# Keycloak (Zwei-Faktor-Anmeldung): trägt `sudo ju-finanzen keycloak-einrichten` ein – nicht von Hand ändern.
# JU_FINANZEN_KEYCLOAK_ISSUER=https://srv1.example.ts.net/auth/realms/ju-hamburg
# JU_FINANZEN_KEYCLOAK_INTERN=http://127.0.0.1:8180/auth/realms/ju-hamburg
# JU_FINANZEN_KEYCLOAK_CLIENT=ju-verwaltung
# JU_FINANZEN_KEYCLOAK_SECRET=
# JU_FINANZEN_KEYCLOAK_RUECKKEHR=https://srv1.example.ts.net/api/keycloak/rueckkehr
# Anmeldung: passwort (Standard) oder keycloak – umstellen mit: sudo ju-finanzen anmeldung keycloak
# JU_FINANZEN_ANMELDUNG=passwort
